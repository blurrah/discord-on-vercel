# Copy to .env.local, or run `vercel env pull` after adding these to your Vercel project.
# Use a separate Discord application for local development (see README).

# Required. Discord Developer Portal → your application → Bot → Reset Token.
DISCORD_TOKEN=

# Optional. Registers slash commands in one server instead of globally (instant updates).
# DISCORD_GUILD_ID=

# Optional. Signs gateway → function requests. Defaults to a key derived from DISCORD_TOKEN.
# DISCORD_RELAY_SECRET=
